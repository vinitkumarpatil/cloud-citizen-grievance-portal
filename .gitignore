# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Environment / secrets ----
.env
**/.env
.env.local
**/.env.local
*.pem
*.key

# ---- Build / cache output ----
dist/
**/dist/
build/
**/build/
.vite/
