# Server configuration
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# CORS origin of the frontend
CLIENT_ORIGIN=http://localhost:5173

# --- Cloud swap-in (optional) ---
# When moving to the cloud, point these at managed services:
# DATABASE_URL=postgres://user:pass@host:5432/grievance   (swap node:sqlite -> Postgres)
# STORAGE_BUCKET=s3://my-grievance-bucket                 (swap local /uploads -> S3)
# AWS_REGION=ap-south-1
